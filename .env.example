# Copy to .env. These values are not baked into the image.
# Replace every change-me before the first start. They are placeholders, not passwords.
POSTGRES_PASSWORD=change-me
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-long-random
PANEL_MASTER_KEY=change-me-long-random

# Image for compose without --build. Pin a release tag, not :latest.
# DNSMARTY_IMAGE=ghcr.io/jav1x/dnsmarty:1.0.0

# Panel TLS. Default: Caddy's own certificate on 7443, which leaves 443 for a proxy on the same machine.
PANEL_HTTPS_PORT=7443
# Let's Encrypt instead: a public name pointing here, and ports 80 and 443 free.
# CADDYFILE=Caddyfile.acme
# PANEL_DOMAIN=panel.example.com
# PANEL_HTTPS_PORT=443
# PANEL_HTTP_PORT=80

# Optional non-interactive agents. The usual path is dnsmarty-node.
DNS_NODE_KEY=
DNS_AGENT_ADDR=:9443
PROXY_NODE_KEY=
PROXY_AGENT_ADDR=:9444

# The session cookie is Secure (__Host-dnsmarty) and HSTS is on by default: the panel is served
# over HTTPS by Caddy. Set to false only for plain-HTTP development on 127.0.0.1:8080.
# PANEL_COOKIE_SECURE=true
# Addresses allowed to set X-Forwarded-For. Default: loopback and private networks.
# PANEL_TRUSTED_PROXIES=127.0.0.0/8,172.16.0.0/12
# LOG_LEVEL=info
