# Copy to .env. These values are not baked into the image.
# Replace every change-me before the first start. They are placeholders, not passwords.
POSTGRES_PASSWORD=change-me
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-long-random
PANEL_MASTER_KEY=change-me-long-random

# 7443 leaves host port 443 free for the proxy on the same machine.
PANEL_HTTPS_PORT=7443

# Optional non-interactive agents. The usual path is dnsmarty-node.
DNS_NODE_KEY=
DNS_AGENT_ADDR=:9443
PROXY_NODE_KEY=
PROXY_AGENT_ADDR=:9444
